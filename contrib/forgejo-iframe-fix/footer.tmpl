<!-- forgepeek:iframe-ref-fix v4
     Two roles:
     A. Progressive enhancement: zoom/pan controls for forgepeek's
        sanitized-mode image previews (.psd/.eps/.ai). Sanitized output
        cannot carry JavaScript, so the interaction lives here in the
        parent page; without this template the previews are simply static.
     B. Works around two Forgejo bugs (present through v16.0.1, unfixed on
        main as of 2026-07-24) affecting BINARY files rendered by
        iframe-mode external renderers:
     1. Empty ref segment in the iframe src ("/owner/repo/render//path"
        404s): routers/web/repo/view.go builds markup metas without
        "BranchNameSubURL" on the binary-file path. Fixed here by
        rebuilding the URL from the raw/download link.
     2. Corrupted input: routers/web/repo/render.go pipes the blob through
        charset.ToUTF8WithFallbackReader before the renderer, mangling
        binary bytes. Fixed here by fetching the pristine /raw/ bytes and
        postMessage-ing them into the viewer, which re-renders when its
        embedded copy failed or differs (see forgepeek's viewer.js).
     Safe no-op on healthy pages / text files. Remove once fixed upstream. -->
<script>
(function () {
  function fix() {
    var f = document.querySelector('iframe.external-render');
    if (!f) return;
    var src;
    try { src = new URL(f.getAttribute('src'), window.location.href); } catch (e) { return; }
    var dl = document.querySelector('a[download]');
    if (!dl) return;
    var raw = new URL(dl.getAttribute('href'), window.location.href).pathname;

    var postRaw = function () {
      fetch(raw).then(function (r) { return r.ok ? r.arrayBuffer() : null; })
        .then(function (buf) {
          if (buf && f.contentWindow) {
            f.contentWindow.postMessage({forgepeekRaw: buf}, '*', [buf]);
          }
        }).catch(function () {});
    };

    var i = src.pathname.indexOf('/render//');
    if (i !== -1) {
      // Bug 1: rebuild the URL (prefix + '/render/' + <ref/path from the
      // correctly-generated raw link>), then redo the height handshake.
      // REPLACE the iframe node rather than mutating src: an src
      // assignment made while the initial (broken) navigation is still in
      // flight is not reliably honored by Chrome.
      var prefix = src.pathname.slice(0, i);
      var rawPrefix = prefix + '/raw/';
      if (raw.indexOf(rawPrefix) !== 0) return;
      var nf = document.createElement('iframe');
      nf.className = f.className;
      nf.width = f.getAttribute('width') || '100%';
      nf.height = f.getAttribute('height') || '300';
      nf.setAttribute('frameborder', f.getAttribute('frameborder') || '0');
      nf.setAttribute('sandbox', f.getAttribute('sandbox') || 'allow-scripts');
      nf.addEventListener('load', function () {
        var onMsg = function (ev) {
          if (ev.source !== nf.contentWindow) return;
          var h = Number(ev.data && ev.data.frameHeight);
          if (!h) return;
          nf.height = h;
          nf.style.overflow = 'hidden';
          window.removeEventListener('message', onMsg);
        };
        window.addEventListener('message', onMsg);
        nf.contentWindow.postMessage({requestOffsetHeight: true}, '*');
        fetch(raw).then(function (r) { return r.ok ? r.arrayBuffer() : null; })
          .then(function (buf) {
            if (buf && nf.contentWindow) {
              nf.contentWindow.postMessage({forgepeekRaw: buf}, '*', [buf]);
            }
          }).catch(function () {});
      });
      nf.src = prefix + '/render/' + raw.slice(rawPrefix.length);
      f.parentNode.replaceChild(nf, f);
    } else {
      // Bug 2 alone (URL already correct): deliver pristine bytes whether
      // the iframe has loaded yet or not; the viewer ignores duplicates.
      f.addEventListener('load', postRaw);
      postRaw();
    }
  }
  // --- zoom/pan for forgepeek image previews (psd/eps/ai) ---------------
  function zoomify() {
    var imgs = document.querySelectorAll('.file-view .forgepeek-image img');
    for (var k = 0; k < imgs.length; k++) enhance(imgs[k]);
  }

  function enhance(img) {
    var box = img.parentNode;
    if (!box || box.getAttribute('data-fp-zoom')) return;
    box.setAttribute('data-fp-zoom', '1');
    box.style.position = 'relative';
    box.style.overflow = 'hidden';
    box.style.touchAction = 'none';
    img.style.transformOrigin = '0 0';
    img.draggable = false;

    var scale = 1, tx = 0, ty = 0;

    var hud = document.createElement('div');
    hud.style.cssText = 'position:absolute;top:8px;right:8px;display:flex;gap:4px;' +
      'align-items:center;font:12px sans-serif;color:#fff;' +
      'background:rgba(0,0,0,.55);border-radius:6px;padding:4px 6px;user-select:none';
    function btn(txt, title, onClick) {
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = txt;
      b.title = title;
      b.style.cssText = 'font:inherit;color:inherit;background:transparent;' +
        'border:1px solid rgba(255,255,255,.4);border-radius:4px;' +
        'padding:1px 7px;cursor:pointer';
      b.addEventListener('click', onClick);
      hud.appendChild(b);
      return b;
    }
    btn('−', 'Zoom out', function () { zoomAtCenter(1 / 1.4); });
    var label = document.createElement('span');
    label.textContent = '100%';
    label.style.minWidth = '3.2em';
    label.style.textAlign = 'center';
    hud.appendChild(label);
    btn('+', 'Zoom in', function () { zoomAtCenter(1.4); });
    btn('reset', 'Fit to view', function () { scale = 1; tx = 0; ty = 0; apply(); });
    box.appendChild(hud);

    function apply() {
      var w = img.clientWidth, h = img.clientHeight;
      var maxX = w * (scale - 1) + w * 0.25, maxY = h * (scale - 1) + h * 0.25;
      tx = Math.max(-maxX, Math.min(tx, w * 0.25));
      ty = Math.max(-maxY, Math.min(ty, h * 0.25));
      if (scale === 1) { tx = 0; ty = 0; }
      img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
      label.textContent = Math.round(scale * 100) + '%';
      img.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
    }

    function zoomTo(next, px, py) {
      next = Math.max(1, Math.min(next, 32));
      var ix = (px - tx) / scale, iy = (py - ty) / scale;
      scale = next;
      tx = px - ix * scale;
      ty = py - iy * scale;
      apply();
    }

    function zoomAtCenter(factor) {
      zoomTo(scale * factor, box.clientWidth / 2, box.clientHeight / 2);
    }

    function boxPoint(e) {
      var r = img.getBoundingClientRect();
      return {
        x: e.clientX - (r.left - tx),
        y: e.clientY - (r.top - ty)
      };
    }

    box.addEventListener('wheel', function (e) {
      e.preventDefault();
      var p = boxPoint(e);
      zoomTo(scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2), p.x, p.y);
    }, { passive: false });

    box.addEventListener('dblclick', function (e) {
      var p = boxPoint(e);
      zoomTo(scale > 1 ? 1 : 3, p.x, p.y);
    });

    var drag = null;
    box.addEventListener('pointerdown', function (e) {
      if (scale <= 1 || e.target.tagName === 'BUTTON') return;
      drag = { x: e.clientX - tx, y: e.clientY - ty };
      img.style.cursor = 'grabbing';
      box.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    box.addEventListener('pointermove', function (e) {
      if (!drag) return;
      tx = e.clientX - drag.x;
      ty = e.clientY - drag.y;
      apply();
    });
    box.addEventListener('pointerup', function () {
      drag = null;
      apply();
    });
  }

  function run() {
    fix();
    zoomify();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>
